# libFuzzer dictionary for the Holocron wire format.
#
# The sealed-message header is a fixed 7-byte magic prefix. Random mutation
# almost never reproduces it, so feeding it as a dictionary token lets the
# fuzzer get past the header check and exercise the encapsulated-key parser and
# AEAD open. Pass with:  cargo +nightly fuzz run unseal -- -dict=holocron.dict

# Full header: VERSION(0x02) || KEM_ID(0x647a) || KDF_ID(0x0001) || AEAD_ID(0x0003)
header="\x02\x64\x7a\x00\x01\x00\x03"
version="\x02"
kem_id_xwing="\x64\x7a"
kdf_id_hkdf_sha256="\x00\x01"
aead_id_chacha20poly1305="\x00\x03"
